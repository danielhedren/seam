#!/bin/sh
# seam [path] [--base ref]: review the repo containing path (default: here) in Seam (SPEC §13).
set -eu
path="$PWD"
base=""
while [ $# -gt 0 ]; do
    case "$1" in
        --base)
            [ $# -ge 2 ] || { echo "seam: --base needs a ref" >&2; exit 64; }
            base="$2"
            shift 2
            ;;
        -h | --help)
            echo "usage: seam [path] [--base ref]"
            exit 0
            ;;
        -*)
            echo "seam: unknown option $1" >&2
            exit 64
            ;;
        *)
            path="$1"
            shift
            ;;
    esac
done
path="$(cd "$path" && pwd -P)"
# Percent-encodes every byte outside the URL's unreserved set.
encode() { printf '%s' "$1" | perl -pe 's/([^A-Za-z0-9\/._~-])/sprintf("%%%02X", ord($1))/ge'; }
url="seam://open?path=$(encode "$path")"
[ -z "$base" ] || url="$url&base=$(encode "$base")"
# Open the copy this script belongs to: a build-dir app and an installed one can coexist, and
# open -b would pick whichever LaunchServices prefers.
self="$(realpath "$0" 2>/dev/null || true)"
case "$self" in
    *.app/Contents/Resources/seam) exec open -a "${self%/Contents/Resources/seam}" "$url" ;;
esac
exec open -b com.danielhedren.seam "$url"
